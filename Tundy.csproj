<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.6.5.0</Version>
    <Description>Plays songs people send you via /tell with "!q [link]": YouTube, Spotify and playlists.</Description>
    <PackageProjectUrl>https://github.com/Clair-songs/Tundy</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Error messages show /_/Tundy/File.cs:line N instead of the folder on the computer that built it. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/Tundy</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Penumbra.Api" Version="5.19.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The music mod song slot's sound settings (with 2 s of silence), for music mods that ship without song files. -->
    <EmbeddedResource Include="Resources\song-slot-template.scd" LogicalName="Tundy.song-slot-template.scd" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plugin icon (the source drawing is images\icon.svg). -->
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" Link="images\icon.png" />
  </ItemGroup>
</Project>
